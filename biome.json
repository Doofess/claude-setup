{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "mods/**/*.ts",
      "mods/**/*.tsx"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "useYield": "off"
      },
      "style": {
        "useTemplate": "off"
      }
    }
  }
}
