{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "supabase@claude-plugins-official": false,
    "telegram@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "claude-security@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": false,
    "shopify-ai-toolkit@claude-plugins-official": false,
    "adobe-for-creativity@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "modern-web-guidance@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "frontend-design@anthropic-plugin-directory": false,
    "superpowers@anthropic-plugin-directory": false,
    "code-review-anthropics@anthropic-plugin-directory": false,
    "skill-creator@anthropic-plugin-directory": false,
    "code-simplifier@anthropic-plugin-directory": false,
    "claude-md-management@anthropic-plugin-directory": false,
    "claude-code-setup@anthropic-plugin-directory": false,
    "ralph-loop@anthropic-plugin-directory": false,
    "supabase@anthropic-plugin-directory": false,
    "security-guidance@anthropic-plugin-directory": false,
    "feature-dev@anthropic-plugin-directory": false,
    "imessage@anthropic-plugin-directory": false
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "fable",
  "statusLine": {
    "type": "command",
    "command": "python ~/.claude/statusline.py"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-dangerous-git.sh",
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "deniedMcpServers": [
    { "serverUrl": "https://mcp.slack.com/*" },
    { "serverUrl": "https://mcp.linear.app/*" },
    { "serverUrl": "https://mcp.atlassian.com/*" },
    { "serverUrl": "https://mcp.notion.com/*" },
    { "serverUrl": "https://mcp.figma.com/*" },
    { "serverUrl": "https://mcp.intercom.com/*" },
    { "serverCommand": ["npx", "-y", "@wonderwhy-er/desktop-commander@latest"] },
    { "serverName": "plugin:finance:snowflake" },
    { "serverName": "plugin:finance:databricks" },
    { "serverName": "plugin:finance:gmail" },
    { "serverName": "plugin:finance:google calendar" },
    { "serverName": "plugin:engineering:gmail" },
    { "serverName": "plugin:engineering:google calendar" },
    { "serverName": "plugin:design:gmail" },
    { "serverName": "plugin:design:google calendar" }
  ],
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
