{
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "good-css": { "source": { "source": "github", "repo": "vojtaholik/good-css" } }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": ["Skill(mattpocock-skills:grilling)", "Skill(grilling)"]
  },
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "<repo>/mods/readable-session",
    "CLAUDE_CODE_NATIVE_CURSOR": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "python -S -c \"import os,sys;sys.path.insert(0,os.path.expanduser('~/.claude'));import statusline;statusline.main()\" --icons nerd",
    "refreshInterval": 1
  },
  "deniedMcpServers": [
    { "serverUrl": "https://mcp.slack.com/*" },
    { "serverUrl": "https://mcp.linear.app/*" },
    { "serverUrl": "https://mcp.atlassian.com/*" },
    { "serverUrl": "https://mcp.notion.com/*" },
    { "serverUrl": "https://mcp.figma.com/*" },
    { "serverUrl": "https://mcp.intercom.com/*" },
    { "serverCommand": ["npx", "-y", "@wonderwhy-er/desktop-commander@latest"] },
    { "serverName": "plugin:finance:snowflake" },
    { "serverName": "plugin:finance:databricks" },
    { "serverName": "plugin:finance:gmail" },
    { "serverName": "plugin:finance:google calendar" },
    { "serverName": "plugin:engineering:gmail" },
    { "serverName": "plugin:engineering:google calendar" },
    { "serverName": "plugin:design:gmail" },
    { "serverName": "plugin:design:google calendar" }
  ],
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 250000,
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
