{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "context7@anthropic-plugin-directory": false,
    "rust-analyzer-lsp@claude-plugins-official": false
  },
  "skillOverrides": {
    "plugin-authoring": "on",
    "docx": "off",
    "pdf": "off",
    "pptx": "off",
    "xlsx": "off",
    "docs": "off",
    "built-in-browser": "off",
    "chrome-browser": "off",
    "computer-use": "off",
    "underwater-photoshop": "off"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_edit.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_tests.py\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
